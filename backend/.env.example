# SECURITY (Requerido: la API no arranca sin estas dos)
# Generar cada una con: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-me
# Clave compartida con scripts/telemetry_streamer.py y tools/radar_bridge.py
INGEST_SECRET_KEY=cambiar_esta_clave_en_el_dot_env

# CORS (Requerido en Prod)
# La URL de tu frontend en Vercel
FRONTEND_URL=https://hailcast-frontend.vercel.app

# RUTAS (Opcional, defaults en código)
# MODEL_PATH=/app/model/best_convlstm_model.pth

# RED (Recomendado en Prod)
# Con 127.0.0.1 los puertos 8000/3000 dejan de estar expuestos a internet y
# solo se llega a la API por el túnel de Cloudflare. Activar recién cuando
# telemetry_streamer.py ya apunte al dominio HTTPS (no a la IP del VPS).
# BIND_ADDRESS=127.0.0.1

# SUPERVISIÓN (Opcional)
# El watchdog reinicia el worker si status.json no se actualiza en este tiempo
# STATUS_MAX_AGE_SECONDS=900
# Avisos por Telegram (crear bot con @BotFather; chat_id con @userinfobot)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# Username del bot (sin @) para el link de vinculación t.me/<bot>?start=... Si falta se consulta getMe.
# TELEGRAM_BOT_USERNAME=HailCastBot

# RAYOS GLM (GOES-19, NOAA, sin credenciales). ~90 MB/h de descarga; nada queda en disco.
# GLM_ENABLED=1
# GLM_BBOX=-37.5,-30.5,-71.0,-65.5     # lat_min,lat_max,lon_min,lon_max (Mendoza + San Juan)
# GLM_KEEP_MINUTES=60
# GLM_POLL_SECONDS=30

# RADARES que atiende el worker, el primero es el primario (San Rafael). Para sumar San Martín: sur,norte
# RADARS=sur

# Intervalo (segundos) con que el watcher consulta Drive. El radar entrega un scan cada 3-4 min.
# WATCHER_INTERVAL=20

# FILTRO DE ECOS FIJOS: una celda cuenta como tormenta solo si tiene > 50 dBZ por encima de esta
# altura (km MSL). Deja afuera el clutter del piedemonte y equivale a la firma clásica de granizo.
# Se aplica a celdas (alertas y marcadores) y a la manga de granizo. 0 desactiva.
# ALERT_MIN_LEVEL_KM=5
# dBZ mínimo, por encima de esa altura, para que un eco cuente como celda (45 = convección fuerte)
# CELL_DBZ_THRESHOLD=45

# ALERTAS A PARQUES SOLARES (Opcional; Telegram privado al chat del admin. Ver backend/services/solar_parks.py)
# Lista de parques: si no existe este archivo se usa deploy/solar_parks.json (versionado)
# SOLAR_PARKS_FILE=/app/data/solar_parks.json
# SOLAR_PARK_ALERT_KM=20          # celda > 50 dBZ a menos de esto → ALERTA
# SOLAR_PARK_CLEAR_KM=25          # ninguna celda a menos de esto → CESE (20–25 es histéresis)
# SOLAR_PARK_REPEAT_MINUTES=30    # repetir el aviso mientras siga la condición
# SOLAR_PARK_HAIL_DBZ=51          # desde este dBZ el tipo es GRANIZO; por debajo, TORMENTA
# Frontend local dentro del contenedor (el de producción está en Vercel)
# ENABLE_LOCAL_FRONTEND=0
# Hilos de PyTorch en CPU
# OMP_NUM_THREADS=2

# RETENCIÓN DE ARCHIVOS (Opcional; ver backend/scripts/cleanup.py)
# Los NetCDF del radar en formato 1000x1000x36 pesan ~44 MB (~17 GB/día).
# CLEANUP_INTERVAL_MINUTES=60
# RETENTION_ARCHIVE_SCANS_HOURS=6
# RETENTION_OUTPUT_PREDICTIONS_HOURS=12
# Guardia por espacio: si queda menos de MIN_FREE_GB se borra lo más viejo hasta TARGET_FREE_GB
# MIN_FREE_GB=8
# TARGET_FREE_GB=12
# El watchdog avisa (Telegram) y fuerza limpieza al superar este uso de disco
# DISK_ALERT_PCT=85

# RECURSOS DEL CONTENEDOR (Opcional). El VPS tiene 4 CPU / 7.8 GB compartidos.
# CONTAINER_MEM_LIMIT=4g
# CONTAINER_CPUS=3.0
# El watchdog avisa si al host le queda menos memoria disponible que esto (MB)
# MEM_ALERT_MB=600
